Include /Users/username/.colima/ssh_config

IgnoreUnknown UseKeychain

Host *
    AddKeysToAgent yes
    UseKeychain yes
    IdentityFile ~/.ssh/id_ed25519

Host mymacstudio
    HostName mymacstudio
    HostKeyAlias mymacstudio.tailecc41a.ts.net
    User username

Host studio
    HostName mms.nukoevi.app
    User username
    ProxyCommand cloudflared access ssh --hostname %h
    LocalForward 5901 localhost:5900

Host mymacbookair
    HostName mymba
    User username

Host mydgxspark
    HostName mydgxspark
    User username
