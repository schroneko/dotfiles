Include /Users/username/.colima/ssh_config

IgnoreUnknown UseKeychain

Host *
    AddKeysToAgent yes
    UseKeychain yes
    IdentityFile ~/.ssh/id_ed25519

Host mymacstudio-cf
    HostName mms.nukoevi.app
    User username
    ProxyCommand cloudflared access ssh --hostname %h
    LocalForward 5901 localhost:5900

Host mymacstudio-ts
    HostName mymacstudio
    HostKeyAlias mymacstudio.tailecc41a.ts.net
    User username

Host mymacbookair
    HostName mymba
    User username

Host mydgxspark-cf
    HostName dgs.nukoevi.app
    User username
    ProxyCommand cloudflared access ssh --hostname %h

Host mydgxspark-ts
    HostName mydgxspark
    User username
